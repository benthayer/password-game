node_modules/
dist/

.env*
.claude/
# TypeScript compiled output (shouldn't exist with noEmit, but just in case)
src/**/*.js
src/**/*.js.map
src/**/*.d.ts
src/**/*.d.ts.map
SECRETS.txt

# Backend runtime data: account records, audit logs, SQLite db, temp uploads.
# Ignore the whole directory - never commit anything that lands here.
packages/backend/data/*
!packages/backend/data/.gitkeep

# Docker volume mount target for the same data (see docker-compose.yml)
/data/
